{
  "name": "@dagegong/sqlite-plugin",
  "version": "0.0.2",
  "description": "",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./dist/*.js": "./dist/*.js",
    "./dist/entity/*.js": "./dist/entity/*.js",
    "./dist/handlers.js": "./dist/handlers.js",
    "./dist/enums.js": "./dist/enums.js",
    "./dist/utils/*.js": "./dist/utils/*.js",
    "./src/enums": "./dist/enums.js",
    "./src/utils/parser": "./dist/utils/parser.js"
  },
  "dependencies": {
    "better-sqlite3": "12.6.2",
    "cli-highlight": "^2.1.11",
    "lodash": "^4.17.21",
    "reflect-metadata": "^0.2.1",
    "tslib": "^2.8.1",
    "typeorm": "0.3.28"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.23",
    "node-gyp": "^12.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "scripts": {
    "dev": "rimraf dist && tsc --outDir dist --watch true",
    "build": "rimraf dist && tsc --outDir dist",
    "postinstall": "npm run build || exit 0;"
