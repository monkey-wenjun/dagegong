[Unit]
Description=Dagegong AI Auto-Reply Daemon
After=network.target

[Service]
Type=simple
User=wenjun
Environment="NVM_DIR=/home/wenjun/.nvm"
Environment="NODE_VERSION=22"
ExecStart=/bin/bash -c 'source $NVM_DIR/nvm.sh && nvm use $NODE_VERSION && cd /home/wenjun/dagegong-app/packages/dagegong-cli && node bin/cli.mjs ai-daemon --daemon'
ExecStop=/bin/bash -c 'source $NVM_DIR/nvm.sh && nvm use $NODE_VERSION && cd /home/wenjun/dagegong-app/packages/dagegong-cli && node bin/cli.mjs ai-daemon --stop'
Restart=always
RestartSec=10
StandardOutput=append:/home/wenjun/.dagegong-cli/logs/ai-daemon-systemd.log
StandardError=append:/home/wenjun/.dagegong-cli/logs/ai-daemon-systemd.log

[Install]
WantedBy=multi-user.target
